# Copy this to .env and fill in your API keys

# Primary: Gemini 2.0 Flash (multimodal - reads PDFs natively including chart images)
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback: Groq Llama 3.1 70B (fast, text-only)
# Get free key: https://console.groq.com
GROQ_API_KEY=

# Legacy: OpenAI (optional)
OPENAI_API_KEY=

# DeepSeek (optional)
DEEPSEEK_API_KEY=
